{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:49998",
            "webRoot": "http://localhost:49998",
            "pathMapping": {
                "/modules/maestro": "${workspaceFolder}"
            },
            "skipFiles": [
                "${workspaceFolder}/libs/**",
                "<node_internals>/**"
            ]
        }
    ]
}
